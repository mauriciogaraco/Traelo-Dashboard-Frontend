# Solo el origen del backend, sin /api/v1 al final — el código lo agrega automáticamente
# (tolera que también venga con /api/v1 incluido, por si tu plataforma de hosting solo
# permite guardar la URL completa).
VITE_API_URL="http://localhost:3000"

# Producción (ver .env.production): VITE_API_URL="https://traelo-dashboard-backend.onrender.com"
